{
  "name": "nijo-learn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:accounts": "node --env-file=.env.local scripts/dev-accounts.mjs",
    "dev:admin": "node --env-file=.env.local scripts/make-admin.mjs",
    "seed:generate": "tsx scripts/build-seed.ts",
    "test:integration": "node --env-file=.env.local --import tsx --test tests/live-api.test.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
