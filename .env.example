# Copy to .env.local. Public values are from npx supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only development account/bootstrap scripts use this server secret.
SUPABASE_SERVICE_ROLE_KEY=
# Explicit safeguard for privileged development scripts. Never use a production project.
NIJO_DEV_PROJECT=false
